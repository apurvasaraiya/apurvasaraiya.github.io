---
const social = [
  { href: 'https://github.com/apurvasaraiya', label: 'github' },
  { href: 'https://www.linkedin.com/in/apurva-saraiya/', label: 'linkedin' },
  { href: 'https://x.com/a____a07', label: 'x' },
];
---

<header class="site-header">
  <div class="container header-row">
    <a href="/" class="wordmark">apurva saraiya</a>
    <nav class="nav-ctas" aria-label="Social">
      {social.map((link, i) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class:list={['btn', i === 0 ? 'btn-solid' : 'btn-ghost']}
        >
          {link.label}<span aria-hidden="true">&nearr;</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: var(--space-3) 0;
    background: rgba(19, 22, 21, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hairline);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--accent);
  }

  .nav-ctas {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.45rem;
  }

  .nav-ctas .btn {
    padding: 0.38rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    gap: 0.3rem;
  }

  .nav-ctas .btn span {
    font-size: 0.7em;
  }

  .nav-ctas .btn-solid { color: var(--paper); }
  .nav-ctas .btn-ghost { color: var(--ink); }

  .nav-ctas .btn-solid:hover,
  .nav-ctas .btn-ghost:hover {
    color: var(--paper);
  }

  @media (max-width: 420px) {
    .nav-ctas { gap: 0.35rem; }
    .nav-ctas .btn {
      padding: 0.32rem 0.55rem;
      font-size: 0.7rem;
    }
  }
</style>
