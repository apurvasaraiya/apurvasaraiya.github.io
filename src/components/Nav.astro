---
const links = [
  { href: '/#now', label: 'now' },
  { href: '/#work', label: 'work' },
  { href: '/#contact', label: 'contact' },
];
---

<header class="site-header">
  <div class="container header-row">
    <a href="/" class="wordmark">apurva saraiya</a>
    <nav aria-label="Main">
      <ul class="nav-links">
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li>
          <a
            href="https://github.com/apurvasaraiya"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-ext"
          >github<span aria-hidden="true">&nearr;</span></a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding: var(--space-3) 0;
  }

  .header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    list-style: none;
  }

  .nav-links a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .nav-links a:hover {
    color: var(--accent);
  }

  .nav-ext span {
    font-size: 0.7em;
    margin-left: 0.15em;
  }

  @media (max-width: 420px) {
    .nav-links {
      gap: 0.75rem;
    }
  }
</style>
