---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-row">
    <span>&copy; {year} Apurva Saraiya &middot; Bengaluru, India</span>
    <a
      href="https://github.com/apurvasaraiya/apurvasaraiya.github.io"
      target="_blank"
      rel="noopener noreferrer"
    >source<span aria-hidden="true">&nearr;</span></a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--hairline);
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .footer-row a {
    color: var(--ink-faint);
  }

  .footer-row a:hover {
    color: var(--accent);
  }

  .footer-row a span {
    font-size: 0.7em;
    margin-left: 0.15em;
  }
</style>
