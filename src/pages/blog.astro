---
import Base from '../layouts/Base.astro';

const topics = [
  'Go Programming',
  'Distributed Systems',
  'Cloud Infrastructure',
  'Kubernetes',
  'Backend Best Practices',
  'System Design',
];
---

<Base title="Blog - Apurva Saraiya" description="Thoughts, tutorials, and insights about backend engineering, distributed systems, and cloud technologies.">
  <!-- Page Header -->
  <section class="page-header">
    <div class="header-glow"></div>
    <div class="container">
      <div class="section-label animate-fade-in">Blog</div>
      <h1 class="animate-fade-in delay-1">Writing & thoughts</h1>
      <p class="page-subtitle animate-fade-in delay-2">
        Thoughts, tutorials, and things I've learned along the way.
      </p>
    </div>
  </section>

  <!-- Coming Soon -->
  <section class="section coming-soon-section">
    <div class="container">
      <div class="coming-soon-card animate-fade-in delay-3">
        <div class="coming-soon-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"/>
            <path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>
          </svg>
        </div>

        <h2>Coming soon</h2>
        <p class="coming-soon-desc">
          I'm working on some posts about backend engineering, distributed systems,
          Go programming, and cloud technologies. Stay tuned.
        </p>

        <div class="topics-section">
          <h3>Topics I'll be covering</h3>
          <div class="topic-tags">
            {topics.map(topic => (
              <span class="topic-tag">{topic}</span>
            ))}
          </div>
        </div>

        <div class="cta-links">
          <span class="cta-text">In the meantime, connect with me:</span>
          <div class="cta-buttons">
            <a href="https://github.com/apurvasaraiya" target="_blank" rel="noopener" class="btn btn-outline">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
            <a href="https://x.com/a____a07" target="_blank" rel="noopener" class="btn btn-outline">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              X / Twitter
            </a>
            <a href="https://www.linkedin.com/in/apurva-saraiya/" target="_blank" rel="noopener" class="btn btn-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-header {
    position: relative;
    padding: calc(var(--space-5xl) + 60px) 0 var(--space-2xl);
    overflow: hidden;
  }

  .header-glow {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(99, 102, 241, 0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .page-header h1 {
    margin-bottom: var(--space-md);
  }

  .section-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-sm);
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    max-width: 520px;
    line-height: 1.7;
  }

  .coming-soon-section {
    padding-top: 0;
    padding-bottom: var(--space-5xl);
  }

  .coming-soon-card {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-3xl) var(--space-2xl);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .coming-soon-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    color: var(--color-accent);
    background: rgba(99, 102, 241, 0.1);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-xl);
  }

  .coming-soon-card h2 {
    margin-bottom: var(--space-md);
  }

  .coming-soon-desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    max-width: 440px;
    margin: 0 auto var(--space-2xl);
    line-height: 1.7;
  }

  .topics-section {
    margin-bottom: var(--space-2xl);
  }

  .topics-section h3 {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-md);
  }

  .topic-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.375rem;
  }

  .topic-tag {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-surface-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: all var(--transition-normal);
  }

  .topic-tag:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .cta-links {
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .cta-text {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
</style>
