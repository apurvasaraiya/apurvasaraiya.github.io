---
import Base from '../layouts/Base.astro';

const work = [
  {
    n: '01',
    name: 'CopyIT',
    href: 'https://github.com/apurvasaraiya/CopyIT',
    meta: 'Python · Linux',
    lede: 'Clipboard history for Linux.',
    text: 'A small Python utility that talks to the real clipboard and remembers what you copied. Grab an hour-old clip without digging through windows.',
  },
  {
    n: '02',
    name: 'shortly',
    href: 'https://github.com/apurvasaraiya/shortly',
    meta: 'Go',
    lede: 'A URL shortener, layered like a real service.',
    text: 'HTTP in Go with controller, service, and repository layers — plus unit tests, mocks, and a Docker build. Short links, honest internals.',
  },
];

const toolbox = [
  { label: 'languages', items: 'Go (Golang) · Python · Bash' },
  { label: 'infra', items: 'Cloud Foundry · BOSH · Kubernetes · Docker' },
  { label: 'data', items: 'PostgreSQL · Redis · Kafka · RabbitMQ' },
  { label: 'cloud & ci', items: 'GCP · AWS · Concourse · Jenkins' },
];
---

<Base title="Apurva Saraiya — Software Engineer · Go, Backend, Distributed Systems">
  <section class="hero">
    <div class="container">
      <p class="eyebrow reveal reveal-1">backend &middot; distributed systems &middot; go</p>

      <h1 class="hero-title reveal reveal-2">
        I write software. Backend, systems, <em>and the bits in between.</em>
      </h1>

      <p class="hero-lede reveal reveal-3">
        By day I work on Cloud Foundry and BOSH — distributed systems in Go.
        Nights, I grind on something of my own.
      </p>

      <div class="pipelines reveal reveal-4" role="img"
        aria-label="Two pipelines: your code through the platform to production — day job. An idea through grinding toward something I'll share soon — nights.">
        <div class="rail">
          <span class="node">your code</span>
          <span class="flow" aria-hidden="true"></span>
          <span class="node-wrap">
            <span class="node node-mine">the platform</span>
            <span class="node-note">&boxur;&nbsp;day job</span>
          </span>
          <span class="flow" aria-hidden="true"></span>
          <span class="node">production</span>
        </div>
        <div class="rail">
          <span class="node">an idea</span>
          <span class="flow" aria-hidden="true"></span>
          <span class="node-wrap">
            <span class="node node-mine">grinding</span>
            <span class="node-note">&boxur;&nbsp;nights</span>
          </span>
          <span class="flow" aria-hidden="true"></span>
          <span class="node">soon</span>
        </div>
      </div>

      <div class="hero-actions reveal reveal-5">
        <a href="https://github.com/apurvasaraiya" target="_blank" rel="noopener noreferrer" class="btn btn-solid">
          GitHub <span aria-hidden="true">&nearr;</span>
        </a>
        <a href="https://www.linkedin.com/in/apurva-saraiya/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          LinkedIn <span aria-hidden="true">&nearr;</span>
        </a>
        <p class="hero-status">
          <span class="status-dot" aria-hidden="true"></span>
          open to backend, AI, and most software roles &middot; Bengaluru, India (IST)
        </p>
      </div>
    </div>
  </section>

  <section class="block" id="now">
    <div class="container">
      <p class="eyebrow">now <span class="eyebrow-note">august 2026</span></p>
      <div class="now-panel">
        <p class="now-kicker">
          <span class="status-dot" aria-hidden="true"></span>
          building
        </p>
        <h2 class="now-title">Something of my own. Sharing soon.</h2>
        <p class="now-lede">
          A personal project, still private. When it's ready to look at,
          it'll live next to the work below.
        </p>
      </div>
    </div>
  </section>

  <section class="block" id="work">
    <div class="container">
      <p class="eyebrow">selected work</p>
      <ul class="work-list">
        {work.map((project) => (
          <li>
            <a class="work-row" href={project.href} target="_blank" rel="noopener noreferrer">
              <span class="work-n" aria-hidden="true">{project.n}</span>
              <span class="work-body">
                <span class="work-head">
                  <span class="work-name">{project.name}</span>
                  <span class="work-meta">{project.meta}</span>
                </span>
                <span class="work-lede">{project.lede}</span>
                <span class="work-text">{project.text}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <p class="eyebrow">toolbox</p>
      <dl class="toolbox">
        {toolbox.map((row) => (
          <div class="toolbox-row">
            <dt>{row.label}</dt>
            <dd>{row.items}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="block" id="contact">
    <div class="container">
      <p class="eyebrow">contact</p>
      <h2 class="contact-title">The work that's out is on GitHub.</h2>
      <p class="contact-lede">
        Start with CopyIT and shortly. For roles — backend, AI, or something
        that doesn't fit a neat label — LinkedIn DMs are open.
      </p>
      <div class="contact-actions">
        <a href="https://github.com/apurvasaraiya" target="_blank" rel="noopener noreferrer" class="btn btn-solid">
          GitHub <span aria-hidden="true">&nearr;</span>
        </a>
        <a href="https://www.linkedin.com/in/apurva-saraiya/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          LinkedIn <span aria-hidden="true">&nearr;</span>
        </a>
        <a href="https://x.com/a____a07" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          X <span aria-hidden="true">&nearr;</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: var(--space-5) 0 var(--space-6);
  }

  .hero-title {
    font-size: clamp(2.5rem, 7.5vw, 4.25rem);
    font-weight: 800;
    max-width: 15ch;
    margin-bottom: var(--space-3);
  }

  .hero-title em {
    font-style: normal;
    color: var(--accent);
  }

  .hero .eyebrow {
    margin-bottom: var(--space-3);
  }

  .hero-lede {
    font-size: 1.0625rem;
    color: var(--ink-soft);
    max-width: 36rem;
    margin-bottom: var(--space-4);
  }

  .pipelines {
    display: grid;
    grid-template-columns: max-content minmax(1rem, 3.5rem) max-content minmax(1rem, 3.5rem) max-content;
    column-gap: 0.5rem;
    row-gap: var(--space-2);
    justify-content: start;
    align-items: start;
    padding: var(--space-3) 0;
    margin-bottom: var(--space-4);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .rail {
    display: contents;
  }

  .node {
    display: inline-block;
    padding: 0.35rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    white-space: nowrap;
    text-align: center;
    color: var(--ink-soft);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius);
    background: var(--paper-raise);
  }

  .node-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .node-mine {
    color: var(--accent-deep);
    border-color: var(--accent);
    background: var(--accent-wash);
    font-weight: 600;
  }

  .node-note {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    padding-left: 0.35rem;
    white-space: nowrap;
  }

  .flow {
    height: 1px;
    align-self: start;
    margin-top: 1.05rem;
    background: var(--hairline-strong);
    position: relative;
  }

  .flow::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    border-left: 5px solid var(--hairline-strong);
    border-top: 3.5px solid transparent;
    border-bottom: 3.5px solid transparent;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hero-status {
    flex-basis: 100%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
    margin: var(--space-1) 0 0;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .status-dot {
      animation: pulse 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .block {
    padding-bottom: var(--space-6);
    scroll-margin-top: 4.5rem;
  }

  .block .eyebrow {
    margin-bottom: var(--space-3);
  }

  .now-panel {
    padding: var(--space-4);
    background: var(--paper-raise);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    border-left: 2px solid var(--accent);
  }

  .now-kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .now-title {
    font-size: clamp(1.75rem, 5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    max-width: 14ch;
    margin-bottom: var(--space-2);
  }

  .now-lede {
    color: var(--ink-soft);
    max-width: 32rem;
    margin-bottom: 0;
  }

  .work-list {
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .work-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--hairline);
    color: inherit;
    align-items: start;
  }

  .work-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    padding-top: 0.55rem;
  }

  .work-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: 0.4rem;
  }

  .work-name {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.5vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    transition: color 150ms ease;
  }

  .work-name::after {
    content: ' \2197';
    font-size: 0.55em;
    font-weight: 600;
    color: var(--ink-faint);
  }

  .work-row:hover .work-name,
  .work-row:hover .work-n {
    color: var(--accent);
  }

  .work-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .work-lede {
    display: block;
    font-size: 1.05rem;
    color: var(--ink);
    margin-bottom: 0.35rem;
  }

  .work-text {
    display: block;
    color: var(--ink-soft);
    max-width: 36rem;
  }

  .toolbox {
    display: flex;
    flex-direction: column;
  }

  .toolbox-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-2);
    align-items: baseline;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .toolbox-row:first-child {
    border-top: 1px solid var(--hairline);
  }

  .toolbox-row dt {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .toolbox-row dd {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .contact-title {
    font-size: clamp(1.75rem, 4.5vw, 2.5rem);
    margin-bottom: var(--space-2);
  }

  .contact-lede {
    color: var(--ink-soft);
    max-width: 34rem;
    margin-bottom: var(--space-3);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 480px) {
    .hero {
      padding-top: var(--space-4);
    }

    .node {
      font-size: 0.68rem;
      padding: 0.3rem 0.5rem;
    }

    .flow {
      margin-top: 0.95rem;
    }

    .now-panel {
      padding: var(--space-3);
    }

    .work-row {
      grid-template-columns: 1.75rem 1fr;
      padding: var(--space-3) 0;
    }

    .toolbox-row {
      grid-template-columns: 5.5rem 1fr;
    }
  }
</style>
