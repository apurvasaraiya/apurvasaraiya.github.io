---
import Base from '../layouts/Base.astro';

const work = [
  {
    n: '01',
    name: 'omarchy-notification-center',
    href: 'https://github.com/apurvasaraiya/omarchy-notification-center',
    meta: 'QML · Quickshell',
    lede: 'A notification center for the Omarchy shell.',
    text: 'A bell in the bar opens a panel of persistent notification history: per-entry delete, clear-all, a configurable depth, and clicks that jump to the sender — relaunching it if it closed. Built as a clone of the stock daemon, the supported way.',
  },
  {
    n: '02',
    name: 'CopyIT',
    href: 'https://github.com/apurvasaraiya/CopyIT',
    meta: 'Python · Linux',
    lede: 'Clipboard history for Linux.',
    text: 'A small Python utility that talks to the real clipboard and remembers what you copied. Grab an hour-old clip without digging through windows.',
  },
  {
    n: '03',
    name: 'shortly',
    href: 'https://github.com/apurvasaraiya/shortly',
    meta: 'Go',
    lede: 'A URL shortener, layered like a real service.',
    text: 'HTTP in Go with controller, service, and repository layers — plus unit tests, mocks, and a Docker build. Short links, honest internals.',
  },
];

const toolbox = [
  { label: 'languages', items: 'Go (Golang) · Python · Bash' },
  { label: 'infra', items: 'Cloud Foundry · BOSH · Kubernetes · Docker' },
  { label: 'data', items: 'PostgreSQL · Redis · Kafka · RabbitMQ' },
  { label: 'cloud & ci', items: 'GCP · AWS · Concourse · Jenkins' },
  { label: 'desktop', items: 'Omarchy · Hyprland · Arch Linux' },
  { label: 'harness', items: 'T3 Code · Cursor · Claude Code · Codex · Gemini · Grok · Pi' },
  { label: 'dev', items: 'bun · Neovim' },
];

const fetchRows = [
  { key: 'OS', value: 'Omarchy (Arch Linux)' },
  { key: 'Host', value: 'Bengaluru, India' },
  { key: 'Day job', value: 'Cloud Foundry & BOSH' },
  { key: 'Org', value: 'VMware by Broadcom (MTS)' },
  { key: 'Now', value: 'something of my own · soon' },
];

const toolboxLeft = toolbox.slice(0, 4);
const toolboxRight = toolbox.slice(4);
---

<Base title="Apurva Saraiya — Software Engineer · Go, Backend, Distributed Systems">
  <section class="hero">
    <div class="container">
      <p class="eyebrow reveal reveal-1">backend &middot; distributed systems &middot; go</p>

      <div class="fetch reveal reveal-2">
        <img
          class="fetch-avatar"
          src="/avatar.png"
          width="500"
          height="500"
          alt="Pixel portrait of Apurva Saraiya"
        />

        <div class="fetch-panel">
          <p class="fetch-name">apurvasaraiya</p>
          <p class="fetch-lede">
            Software engineer. Backend, systems, and the bits in between.
          </p>
          <dl class="fetch-id">
            {fetchRows.map((row) => (
              <div class="fetch-row">
                <dt>{row.key}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <dl class="toolbox-side">
          {toolboxLeft.map((row) => (
            <div class="toolbox-row">
              <dt>{row.label}</dt>
              <dd>{row.items}</dd>
            </div>
          ))}
        </dl>
        <dl class="toolbox-side toolbox-side-end">
          {toolboxRight.map((row) => (
            <div class="toolbox-row">
              <dt>{row.label}</dt>
              <dd>{row.items}</dd>
            </div>
          ))}
        </dl>
      </div>

      <p class="hero-status reveal reveal-3">
        <span class="status-dot" aria-hidden="true"></span>
        open to backend, AI, and most software roles &middot; Bengaluru, India (IST)
      </p>
    </div>
  </section>

  <section class="block" id="now">
    <div class="container">
      <p class="eyebrow">now <span class="eyebrow-note">august 2026</span></p>
      <div class="now-panel">
        <p class="now-kicker">
          <span class="status-dot" aria-hidden="true"></span>
          building
        </p>
        <h2 class="now-title">Something of my own. Sharing soon.</h2>
        <p class="now-lede">
          A personal project, still private. When it's ready to look at,
          it'll live next to the work below.
        </p>
      </div>
    </div>
  </section>

  <section class="block" id="work">
    <div class="container">
      <p class="eyebrow">selected work</p>
      <ul class="work-list">
        {work.map((project) => (
          <li>
            <a class="work-row" href={project.href} target="_blank" rel="noopener noreferrer">
              <span class="work-n" aria-hidden="true">{project.n}</span>
              <span class="work-body">
                <span class="work-head">
                  <span class="work-name">{project.name}</span>
                  <span class="work-meta">{project.meta}</span>
                </span>
                <span class="work-lede">{project.lede}</span>
                <span class="work-text">{project.text}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: var(--space-4) 0 var(--space-6);
  }

  .hero .eyebrow {
    margin-bottom: var(--space-3);
  }

  .fetch {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .fetch-avatar {
    display: block;
    width: min(14.5rem, 72vw);
    height: auto;
    margin: 0 auto;
    image-rendering: -moz-crisp-edges;
    image-rendering: pixelated;
  }

  .fetch-panel {
    min-width: 0;
    align-self: center;
  }

  .fetch-name {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 0.35rem;
  }

  .fetch-lede {
    font-size: 1.05rem;
    color: var(--ink-soft);
    max-width: 28rem;
    margin: 0 0 var(--space-2);
  }

  .fetch-id {
    display: grid;
    gap: 0.15rem;
  }

  .fetch-row {
    display: grid;
    grid-template-columns: 5.6em 1fr;
    column-gap: 0.85em;
    align-items: baseline;
  }

  .fetch-row dt {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }

  .fetch-row dd {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink-soft);
    min-width: 0;
  }

  .hero-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
    margin: var(--space-3) 0 0;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .status-dot { animation: pulse 2.4s var(--ease-out) infinite; }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .block {
    padding-bottom: var(--space-6);
    scroll-margin-top: 4.5rem;
  }

  .block .eyebrow { margin-bottom: var(--space-3); }

  .now-panel {
    padding: var(--space-4);
    background: var(--paper-raise);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    border-left: 2px solid var(--accent);
  }

  .now-kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .now-title {
    font-size: clamp(1.75rem, 5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    max-width: 14ch;
    margin-bottom: var(--space-2);
  }

  .now-lede {
    color: var(--ink-soft);
    max-width: 32rem;
    margin-bottom: 0;
  }

  .work-list {
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .work-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--hairline);
    color: inherit;
    align-items: start;
  }

  .work-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    padding-top: 0.55rem;
  }

  .work-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: 0.4rem;
  }

  .work-name {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.5vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    transition: color 150ms ease;
  }

  .work-name::after {
    content: ' \2197';
    font-size: 0.55em;
    font-weight: 600;
    color: var(--ink-faint);
  }

  .work-row:hover .work-name,
  .work-row:hover .work-n { color: var(--accent); }

  .work-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .work-lede {
    display: block;
    font-size: 1.05rem;
    color: var(--ink);
    margin-bottom: 0.35rem;
  }

  .work-text {
    display: block;
    color: var(--ink-soft);
    max-width: 36rem;
  }

  .toolbox-side {
    min-width: 0;
  }

  .toolbox-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-2);
    align-items: baseline;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .toolbox-side .toolbox-row:first-child { border-top: 1px solid var(--hairline); }
  .toolbox-side-end .toolbox-row:first-child { border-top: 0; }
  .toolbox-row dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }
  .toolbox-row dd {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  @media (min-width: 720px) {
    .fetch {
      grid-template-columns: minmax(16rem, 1fr) minmax(0, 1.15fr);
      grid-template-areas:
        "ascii panel"
        "tbl   tbr";
      column-gap: var(--space-4);
      row-gap: var(--space-3);
      align-items: center;
    }

    .fetch-avatar {
      grid-area: ascii;
      width: min(16rem, 100%);
      margin: 0;
    }

    .fetch-panel { grid-area: panel; }

    .toolbox-side { grid-area: tbl; align-self: start; }
    .toolbox-side-end { grid-area: tbr; align-self: start; }
    .toolbox-side-end .toolbox-row:first-child {
      border-top: 1px solid var(--hairline);
    }
    .toolbox-row {
      grid-template-columns: 1fr;
      gap: 0.12rem;
    }
  }

  @media (max-width: 480px) {
    .hero { padding-top: var(--space-3); }

    .toolbox-row { grid-template-columns: 6.25rem 1fr; }

    .now-panel { padding: var(--space-3); }
    .work-row {
      grid-template-columns: 1.75rem 1fr;
      padding: var(--space-3) 0;
    }
  }
</style>
