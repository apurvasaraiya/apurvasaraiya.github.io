---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';

const featuredProjects = [
  {
    title: 'shortly',
    description: 'A URL shortener service built with Go, focusing on high performance, clean architecture, and simplicity.',
    tags: ['Go', 'Backend', 'REST API'],
    href: 'https://github.com/apurvasaraiya/shortly',
  },
  {
    title: 'CopyIT',
    description: 'Copy paste utility built using Python and Linux packages with clipboard history support.',
    tags: ['Python', 'Linux', 'CLI'],
    href: 'https://github.com/apurvasaraiya/CopyIT',
  },
  {
    title: 'dotfiles',
    description: 'Personal dotfiles and machine setup configurations for optimal development workflow.',
    tags: ['Shell', 'Linux', 'DevOps'],
    href: 'https://github.com/apurvasaraiya/dotfiles',
  },
  {
    title: 'go-grep',
    description: 'A grep implementation in Go with regex pattern matching and file searching capabilities.',
    tags: ['Go', 'CLI', 'Regex'],
    href: 'https://github.com/apurvasaraiya/go-grep',
  },
];

const skills = [
  { name: 'Go', category: 'language' },
  { name: 'Python', category: 'language' },
  { name: 'Shell', category: 'language' },
  { name: 'JavaScript', category: 'language' },
  { name: 'React', category: 'frontend' },
  { name: 'HTML/CSS', category: 'frontend' },
  { name: 'Docker', category: 'infra' },
  { name: 'Kubernetes', category: 'infra' },
  { name: 'GCP', category: 'infra' },
  { name: 'AWS', category: 'infra' },
  { name: 'PostgreSQL', category: 'data' },
  { name: 'Redis', category: 'data' },
  { name: 'Kafka', category: 'data' },
  { name: 'RabbitMQ', category: 'data' },
  { name: 'Git', category: 'tools' },
  { name: 'Linux', category: 'tools' },
  { name: 'Jenkins', category: 'tools' },
  { name: 'Concourse CI', category: 'tools' },
];
---

<Base title="Apurva Saraiya - Software Engineer">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-glow hero-glow-1"></div>
      <div class="hero-glow hero-glow-2"></div>
      <div class="hero-grid"></div>
    </div>

    <div class="container hero-container">
      <div class="hero-badge animate-fade-in">
        <span class="badge-dot"></span>
        Available for opportunities
      </div>

      <h1 class="hero-title animate-fade-in delay-1">
        Hi, I'm <span class="text-gradient">Apurva Saraiya</span>
      </h1>

      <p class="hero-subtitle animate-fade-in delay-2">
        Software Engineer passionate about building
        <strong>robust backend systems</strong>,
        <strong>cloud infrastructure</strong>,
        and <strong>distributed systems</strong>.
        Based in Surat, India.
      </p>

      <div class="hero-cta animate-fade-in delay-3">
        <a href="https://www.linkedin.com/in/apurva-saraiya/" target="_blank" rel="noopener" class="btn btn-primary">
          Let's Connect
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7"/>
            <path d="M7 7h10v10"/>
          </svg>
        </a>
        <a href="https://github.com/apurvasaraiya" target="_blank" rel="noopener" class="btn btn-outline">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </a>
      </div>

      <div class="hero-stack animate-fade-in delay-4">
        <span class="stack-label">Currently working with</span>
        <div class="stack-items">
          <span class="stack-item">Go</span>
          <span class="stack-dot"></span>
          <span class="stack-item">Cloud</span>
          <span class="stack-dot"></span>
          <span class="stack-item">CloudFoundry</span>
          <span class="stack-dot"></span>
          <span class="stack-item">BOSH</span>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="section about" id="about">
    <div class="container">
      <div class="section-label animate-fade-in">About</div>
      <h2 class="section-title animate-fade-in delay-1">A bit about me</h2>

      <div class="about-content">
        <div class="about-text animate-fade-in delay-2">
          <p>
            I'm a Software Engineer passionate about crafting robust backend systems
            and leveraging the power of the cloud. I thrive on solving complex problems
            and continuously exploring new technologies.
          </p>
          <p>
            Currently working on Go, Cloud, CloudFoundry, and BOSH. I'm also diving deeper into
            Operating Systems, Distributed Systems, and AI/ML. Always looking
            to collaborate on interesting projects.
          </p>
        </div>

        <div class="about-interests animate-fade-in delay-3">
          <div class="interest-card">
            <div class="interest-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"/>
                <polyline points="8 6 2 12 8 18"/>
              </svg>
            </div>
            <div>
              <h4>Backend Systems</h4>
              <p>Building scalable, performant services with clean architecture</p>
            </div>
          </div>
          <div class="interest-card">
            <div class="interest-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
              </svg>
            </div>
            <div>
              <h4>Cloud & Infrastructure</h4>
              <p>Designing reliable infrastructure on GCP, AWS, and Kubernetes</p>
            </div>
          </div>
          <div class="interest-card">
            <div class="interest-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/>
                <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
              </svg>
            </div>
            <div>
              <h4>AI & Machine Learning</h4>
              <p>Exploring intelligent systems and building AI-powered solutions</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="section skills" id="skills">
    <div class="container">
      <div class="section-label animate-fade-in">Skills</div>
      <h2 class="section-title animate-fade-in delay-1">Tech stack</h2>
      <p class="section-subtitle animate-fade-in delay-2">Technologies I work with on a daily basis</p>

      <div class="skills-grid animate-fade-in delay-3">
        {skills.map(skill => (
          <div class="skill-pill">
            {skill.name}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section class="section projects" id="projects">
    <div class="container">
      <div class="section-header-row">
        <div>
          <div class="section-label animate-fade-in">Projects</div>
          <h2 class="section-title animate-fade-in delay-1">Featured work</h2>
        </div>
        <a href="/projects" class="view-all-link animate-fade-in delay-2">
          View all projects
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="projects-grid">
        {featuredProjects.map((project, i) => (
          <div class={`animate-fade-in delay-${(i % 4) + 2}`}>
            <Card
              title={project.title}
              description={project.description}
              tags={project.tags}
              href={project.href}
              variant="project"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-card animate-fade-in">
        <div class="cta-glow"></div>
        <h2>Let's work together</h2>
        <p>I'm always open to discussing new opportunities, interesting projects, or just having a good conversation about tech.</p>
        <div class="cta-buttons">
          <a href="https://www.linkedin.com/in/apurva-saraiya/" target="_blank" rel="noopener" class="btn btn-primary">
            Get in touch
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7"/>
              <path d="M7 7h10v10"/>
            </svg>
          </a>
          <a href="https://github.com/apurvasaraiya" target="_blank" rel="noopener" class="btn btn-outline">
            View GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero Section */
  .hero {
    position: relative;
    padding: calc(var(--space-5xl) + 60px) 0 var(--space-5xl);
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
  }

  .hero-glow-1 {
    width: 600px;
    height: 600px;
    top: -200px;
    left: -100px;
    background: rgba(99, 102, 241, 0.08);
  }

  .hero-glow-2 {
    width: 500px;
    height: 500px;
    bottom: -150px;
    right: -100px;
    background: rgba(139, 92, 246, 0.06);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 60% 50% at 50% 30%, black 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 30%, black 30%, transparent 70%);
  }

  .hero-container {
    max-width: 720px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.375rem 1rem;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-xl);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--color-green);
    border-radius: 50%;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
    50% { opacity: 0.8; box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
  }

  .hero-title {
    margin-bottom: var(--space-lg);
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 560px;
    margin-bottom: var(--space-2xl);
    line-height: 1.7;
  }

  .hero-subtitle strong {
    color: var(--color-text);
    font-weight: 500;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-3xl);
  }

  .hero-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .stack-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: var(--font-display);
    font-weight: 500;
  }

  .stack-items {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .stack-item {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    font-family: var(--font-display);
    font-weight: 500;
  }

  .stack-dot {
    width: 3px;
    height: 3px;
    background: var(--color-text-muted);
    border-radius: 50%;
  }

  /* Section Styles */
  .section-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-sm);
  }

  .section-title {
    margin-bottom: var(--space-md);
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2xl);
    max-width: 480px;
  }

  /* About Section */
  .about {
    border-top: 1px solid var(--color-border);
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .about-text p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .about-text p:last-child {
    margin-bottom: 0;
  }

  .about-interests {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .interest-card {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-normal);
  }

  .interest-card:hover {
    border-color: var(--color-border-hover);
    transform: translateX(4px);
  }

  .interest-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    background: rgba(99, 102, 241, 0.1);
    border-radius: var(--radius-md);
  }

  .interest-card h4 {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .interest-card p {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
    line-height: 1.5;
  }

  /* Skills Section */
  .skills {
    border-top: 1px solid var(--color-border);
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-pill {
    padding: 0.5rem 1rem;
    font-family: var(--font-display);
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: all var(--transition-normal);
  }

  .skill-pill:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
    background: rgba(99, 102, 241, 0.06);
  }

  /* Projects Section */
  .projects {
    border-top: 1px solid var(--color-border);
  }

  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-2xl);
  }

  .section-header-row .section-title {
    margin-bottom: 0;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: all var(--transition-normal);
  }

  .view-all-link:hover {
    color: var(--color-accent);
  }

  .view-all-link:hover svg {
    transform: translateX(4px);
  }

  .view-all-link svg {
    transition: transform var(--transition-normal);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  /* CTA Section */
  .cta-section {
    border-top: 1px solid var(--color-border);
  }

  .cta-card {
    position: relative;
    text-align: center;
    padding: var(--space-4xl) var(--space-2xl);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .cta-glow {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 200px;
    background: radial-gradient(ellipse, rgba(99, 102, 241, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-card h2 {
    position: relative;
    margin-bottom: var(--space-md);
  }

  .cta-card p {
    position: relative;
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 480px;
    margin: 0 auto var(--space-xl);
    line-height: 1.7;
  }

  .cta-buttons {
    position: relative;
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding: calc(var(--space-3xl) + 60px) 0 var(--space-3xl);
      min-height: auto;
    }

    .hero-container {
      text-align: left;
    }

    .about-content {
      grid-template-columns: 1fr;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .section-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }

    .cta-card {
      padding: var(--space-2xl) var(--space-lg);
    }
  }
</style>
