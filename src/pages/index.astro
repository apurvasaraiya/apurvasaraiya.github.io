---
import Base from '../layouts/Base.astro';

const now = [
  {
    label: 'building',
    text: 'Desk — a local command center that runs multiple CLI coding agents (Claude Code, Cursor, Codex) across repos, with no API keys. Open-sourcing soon.',
  },
  {
    label: 'exploring',
    text: 'QEMU/KVM sandboxes for running untrusted agent workloads in genuine isolation.',
  },
  {
    label: 'studying',
    text: 'Operating-systems and distributed-systems internals — the fundamentals keep paying rent.',
  },
];

const work = [
  {
    name: 'go-grep',
    href: 'https://github.com/apurvasaraiya/go-grep',
    meta: 'Go',
    text: 'grep rebuilt from scratch — regex matching, recursive file walking, honest CLI ergonomics.',
  },
  {
    name: 'dotfiles',
    href: 'https://github.com/apurvasaraiya/dotfiles',
    meta: 'Linux',
    text: 'One repo from bare Arch to a full working machine — Hyprland, shell, editor, the lot.',
  },
  {
    name: 'apurvasaraiya.github.io',
    href: 'https://github.com/apurvasaraiya/apurvasaraiya.github.io',
    meta: 'Astro',
    text: 'This site — a hand-rolled design system, no CSS frameworks, static and fast.',
  },
];

const toolbox = [
  { label: 'languages', items: 'Go (Golang) · Python · Bash' },
  { label: 'platforms', items: 'Cloud Foundry · BOSH · Kubernetes · Docker' },
  { label: 'data', items: 'PostgreSQL · Redis · Kafka · RabbitMQ' },
  { label: 'cloud & ci', items: 'GCP · AWS · Concourse · Jenkins' },
];
---

<Base title="Apurva Saraiya — Platform Engineer · Go, Cloud Foundry, AI Agent Infrastructure">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow reveal reveal-1">platform engineering &middot; distributed systems &middot; go</p>

      <h1 class="hero-title reveal reveal-2">
        I build platforms that run <em>other people's code.</em>
      </h1>

      <p class="hero-lede reveal reveal-3">
        By day, Cloud Foundry &amp; BOSH platform R&amp;D — distributed systems in Go, the
        machinery enterprises trust with production. After hours, infrastructure for AI
        coding agents: orchestration, sandboxes, local-first tooling. The problems are
        the same — scheduling, isolation, safe rollouts. The workloads just got stranger.
      </p>

      <!-- Signature: the two pipelines, annotated -->
      <div class="pipelines reveal reveal-4" role="img"
        aria-label="Two pipelines: your code flows through the platform to production — my day job. An AI agent flows through a sandbox to your codebase — my after-hours work.">
        <div class="rail">
          <span class="node">your code</span>
          <span class="flow" aria-hidden="true"></span>
          <span class="node-wrap">
            <span class="node node-mine">the platform</span>
            <span class="node-note">&boxur;&nbsp;day job</span>
          </span>
          <span class="flow" aria-hidden="true"></span>
          <span class="node">production</span>
        </div>
        <div class="rail">
          <span class="node">an ai agent</span>
          <span class="flow" aria-hidden="true"></span>
          <span class="node-wrap">
            <span class="node node-mine">a sandbox</span>
            <span class="node-note">&boxur;&nbsp;after hours</span>
          </span>
          <span class="flow" aria-hidden="true"></span>
          <span class="node">your codebase</span>
        </div>
      </div>

      <div class="hero-actions reveal reveal-5">
        <a href="https://github.com/apurvasaraiya" target="_blank" rel="noopener noreferrer" class="btn btn-solid">
          GitHub <span aria-hidden="true">&nearr;</span>
        </a>
        <a href="https://www.linkedin.com/in/apurva-saraiya/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          LinkedIn <span aria-hidden="true">&nearr;</span>
        </a>
        <p class="hero-status">
          <span class="status-dot" aria-hidden="true"></span>
          open to platform &amp; AI-infrastructure conversations &middot; Surat, India (IST)
        </p>
      </div>
    </div>
  </section>

  <!-- Now -->
  <section class="block" id="now">
    <div class="container">
      <p class="eyebrow">now <span class="eyebrow-note">august 2026</span></p>
      <ul class="log">
        {now.map((entry) => (
          <li class="log-row">
            <span class="log-label">{entry.label}</span>
            <p class="log-text">{entry.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Selected work -->
  <section class="block" id="work">
    <div class="container">
      <p class="eyebrow">selected work</p>
      <ul class="work-list">
        {work.map((project) => (
          <li>
            <a class="work-row" href={project.href} target="_blank" rel="noopener noreferrer">
              <span class="work-head">
                <span class="work-name">{project.name}</span>
                <span class="work-meta">{project.meta}</span>
              </span>
              <span class="work-text">{project.text}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="archive-note">
        from the archive —
        <a href="https://github.com/apurvasaraiya/shortly" target="_blank" rel="noopener noreferrer">shortly</a>, a Go URL shortener &middot;
        <a href="https://github.com/apurvasaraiya/CopyIT" target="_blank" rel="noopener noreferrer">CopyIT</a>, a Python clipboard manager.
        Retired, kept as history.
      </p>
    </div>
  </section>

  <!-- Toolbox -->
  <section class="block">
    <div class="container">
      <p class="eyebrow">toolbox</p>
      <dl class="toolbox">
        {toolbox.map((row) => (
          <div class="toolbox-row">
            <dt>{row.label}</dt>
            <dd>{row.items}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Contact -->
  <section class="block" id="contact">
    <div class="container">
      <p class="eyebrow">contact</p>
      <h2 class="contact-title">The commit history says it best.</h2>
      <p class="contact-lede">
        The fastest way to see how I work is my GitHub. For everything else — roles,
        collaborations, or a good systems argument — my LinkedIn DMs are open.
      </p>
      <div class="contact-actions">
        <a href="https://github.com/apurvasaraiya" target="_blank" rel="noopener noreferrer" class="btn btn-solid">
          GitHub <span aria-hidden="true">&nearr;</span>
        </a>
        <a href="https://www.linkedin.com/in/apurva-saraiya/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          LinkedIn <span aria-hidden="true">&nearr;</span>
        </a>
        <a href="https://x.com/a____a07" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          X <span aria-hidden="true">&nearr;</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding: var(--space-5) 0 var(--space-6);
  }

  .hero-title {
    font-size: clamp(2.5rem, 7.5vw, 4.25rem);
    font-weight: 800;
    max-width: 15ch;
    margin-bottom: var(--space-3);
  }

  .hero-title em {
    font-style: normal;
    color: var(--accent);
  }

  .hero .eyebrow {
    margin-bottom: var(--space-3);
  }

  .hero-lede {
    font-size: 1.0625rem;
    color: var(--ink-soft);
    max-width: 38rem;
    margin-bottom: var(--space-4);
  }

  /* Pipelines diagram */
  .pipelines {
    display: grid;
    grid-template-columns: max-content minmax(1rem, 3.5rem) max-content minmax(1rem, 3.5rem) max-content;
    column-gap: 0.5rem;
    row-gap: var(--space-2);
    justify-content: start;
    align-items: start;
    padding: var(--space-3) 0;
    margin-bottom: var(--space-4);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  /* Rails dissolve into the shared grid so columns align across both rows */
  .rail {
    display: contents;
  }

  .node {
    display: inline-block;
    padding: 0.35rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    white-space: nowrap;
    text-align: center;
    color: var(--ink-soft);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius);
    background: var(--paper-raise);
  }

  .node-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .node-mine {
    color: var(--accent-deep);
    border-color: var(--accent);
    background: var(--accent-wash);
    font-weight: 600;
  }

  .node-note {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    padding-left: 0.35rem;
    white-space: nowrap;
  }

  .flow {
    height: 1px;
    align-self: start;
    margin-top: 1.05rem;
    background: var(--hairline-strong);
    position: relative;
  }

  .flow::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    border-left: 5px solid var(--hairline-strong);
    border-top: 3.5px solid transparent;
    border-bottom: 3.5px solid transparent;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hero-status {
    flex-basis: 100%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
    margin: var(--space-1) 0 0;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Section rhythm */
  .block {
    padding-bottom: var(--space-6);
  }

  .block .eyebrow {
    margin-bottom: var(--space-3);
  }

  /* Now log */
  .log {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .log-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-2);
    align-items: baseline;
  }

  .log-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
  }

  .log-text {
    color: var(--ink-soft);
    margin-bottom: 0;
  }

  /* Work list */
  .work-list {
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .work-row {
    display: block;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--hairline);
    color: inherit;
  }

  .work-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: 0.35rem;
  }

  .work-name {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    transition: color 150ms ease;
  }

  .work-name::after {
    content: ' \2197';
    font-size: 0.75em;
    color: var(--ink-faint);
  }

  .work-row:hover .work-name {
    color: var(--accent);
  }

  .work-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .work-text {
    display: block;
    color: var(--ink-soft);
    max-width: 36rem;
  }

  .archive-note {
    margin-top: var(--space-3);
    font-size: 0.875rem;
    color: var(--ink-faint);
    max-width: 36rem;
  }

  /* Toolbox */
  .toolbox {
    display: flex;
    flex-direction: column;
  }

  .toolbox-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-2);
    align-items: baseline;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .toolbox-row:first-child {
    border-top: 1px solid var(--hairline);
  }

  .toolbox-row dt {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .toolbox-row dd {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  /* Contact */
  .contact-title {
    font-size: clamp(1.75rem, 4.5vw, 2.5rem);
    margin-bottom: var(--space-2);
  }

  .contact-lede {
    color: var(--ink-soft);
    max-width: 34rem;
    margin-bottom: var(--space-3);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Mobile */
  @media (max-width: 480px) {
    .hero {
      padding-top: var(--space-4);
    }

    .rail {
      gap: 0.4rem;
    }

    .node {
      font-size: 0.68rem;
      padding: 0.3rem 0.5rem;
    }

    .flow {
      margin-top: 0.95rem;
    }

    .log-row,
    .toolbox-row {
      grid-template-columns: 5.5rem 1fr;
    }
  }
</style>
