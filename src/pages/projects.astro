---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';

const projects = [
  {
    title: 'shortly',
    description: 'A URL shortener service built with Go, focusing on high performance, clean architecture, and simplicity. Designed to handle high traffic with minimal resource usage.',
    tags: ['Go', 'Backend', 'REST API', 'URL Shortener'],
    href: 'https://github.com/apurvasaraiya/shortly',
  },
  {
    title: 'CopyIT',
    description: 'A powerful copy-paste utility built using Python and Linux packages. Features clipboard history support for seamless workflow enhancement.',
    tags: ['Python', 'Linux', 'CLI', 'Utility'],
    href: 'https://github.com/apurvasaraiya/CopyIT',
  },
  {
    title: 'dotfiles',
    description: 'Personal dotfiles and machine setup configurations. Includes shell configurations, editor settings, and development environment setup for optimal workflow.',
    tags: ['Shell', 'Linux', 'DevOps', 'Configuration'],
    href: 'https://github.com/apurvasaraiya/dotfiles',
  },
  {
    title: 'go-grep',
    description: 'A grep implementation in Go with regex pattern matching and file searching capabilities. Exploring low-level text processing.',
    tags: ['Go', 'CLI', 'Regex', 'Tools'],
    href: 'https://github.com/apurvasaraiya/go-grep',
  },
];
---

<Base title="Projects - Apurva Saraiya" description="Explore my portfolio of projects spanning backend development, cloud infrastructure, and developer tools.">
  <!-- Page Header -->
  <section class="page-header">
    <div class="header-glow"></div>
    <div class="container">
      <div class="section-label animate-fade-in">Projects</div>
      <h1 class="animate-fade-in delay-1">Things I've built</h1>
      <p class="page-subtitle animate-fade-in delay-2">
        A collection of projects spanning backend services, developer tools, and utilities.
        Each one taught me something new.
      </p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="section projects-section">
    <div class="container">
      <div class="projects-grid">
        {projects.map((project, i) => (
          <div class={`animate-fade-in delay-${(i % 4) + 1}`}>
            <Card
              title={project.title}
              description={project.description}
              tags={project.tags}
              href={project.href}
              variant="project"
            />
          </div>
        ))}
      </div>

      <!-- Open Source CTA -->
      <div class="os-card animate-fade-in delay-3">
        <div class="os-content">
          <div class="os-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </div>
          <div>
            <h3>More on GitHub</h3>
            <p>Check out my GitHub for more projects, contributions, and experiments.</p>
          </div>
          <a href="https://github.com/apurvasaraiya" target="_blank" rel="noopener" class="btn btn-outline">
            View Profile
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7"/>
              <path d="M7 7h10v10"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-header {
    position: relative;
    padding: calc(var(--space-5xl) + 60px) 0 var(--space-2xl);
    overflow: hidden;
  }

  .header-glow {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(99, 102, 241, 0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .page-header h1 {
    margin-bottom: var(--space-md);
  }

  .section-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-sm);
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    max-width: 520px;
    line-height: 1.7;
  }

  .projects-section {
    padding-top: var(--space-2xl);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-3xl);
  }

  .os-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .os-content {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .os-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    background: var(--color-surface-hover);
    border-radius: var(--radius-md);
  }

  .os-content h3 {
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .os-content p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
    flex: 1;
  }

  .os-content .btn {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .os-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
